# Original copyrighted game files — never commit. Supply your own legally
# obtained copy locally to run the extraction pipeline (see README.md).
original/

# Raw assets extracted directly from the original binary — regenerated
# locally by the extraction tooling, not redistributed.
extraction/resources/
extraction/forms/
extraction/pcode/

# Node / Vite
port/node_modules/
port/dist/
port/.vite/

# Wine prefix(es) used for the reference oracle, and for local VB3 IDE
# research (that workflow now lives in the vb3-decompiler companion repo,
# but this directory may still exist locally).
.wine32/
.winedefault/
.winevb3/

# Local VB3 IDE research workspace -- superseded by the vb3-decompiler
# companion repo's work/ directory, but ignore here too in case it
# lingers locally.
vb3_install/
*.7z

# Editor/OS cruft
.DS_Store

# Python
__pycache__/
*.pyc
